    "required_fields_for_user_selected_station": [
      "stationKey",
      "routeId",
      "displayName"
    ],
    "rule": "用户选择起点/终点后，后续路线规划、实时状态、换乘判断与通知发布必须继续使用所选 stationKey + routeId；禁止在后续阶段仅凭 displayName/name 做模糊 resolveStationKey。",
    "reason": "防止深圳10号线坂田北被重新按站名模糊匹配成5号线坂田。"
  },
  "label_verification": {
